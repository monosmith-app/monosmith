{
  "name": "smith",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.27",
      "golangciLintVersion": "2.15.0"
    },
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "1.99",
      "profile": "default"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "jdkDistro": "tem",
      "installGradle": true,
      "gradleVersion": "9.8.1",
      "installMaven": true,
      "mavenVersion": "3.10.0"
    },
    "ghcr.io/devcontainers/features/php:1": {
      "version": "8.4"
    },
    "ghcr.io/devcontainers/features/ruby:1": {
      "version": "3.4"
    }
  },
  "remoteEnv": {
    "VCPKG_ROOT": "${containerEnv:HOME}/vcpkg"
  },
  "postCreateCommand": "npm install -g npm@12 && npm ci && sudo apt-get update && sudo apt-get install -y --no-install-recommends build-essential cmake ninja-build cppcheck pkg-config zip unzip && ([ -d \"$HOME/vcpkg\" ] || (git clone --depth 1 --branch 2026.07.29 https://github.com/microsoft/vcpkg \"$HOME/vcpkg\" && \"$HOME/vcpkg/bootstrap-vcpkg.sh\" -disableMetrics)) && npx smith ci setup",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "nrwl.angular-console",
        "firsttris.vscode-jest-runner"
      ]
    }
  }
}

