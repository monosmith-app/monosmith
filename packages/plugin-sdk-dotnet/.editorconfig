root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,json,md,yml,yaml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_diagnostic.IDE0005.severity = warning

# The public types share one namespace (MonoSmith.Plugin.Sdk) so that one using is all a plugin needs;
# the folders are the slices. The namespace therefore does not follow the folder.
dotnet_diagnostic.IDE0130.severity = none

# Exceptions are named for their role in a slice (RpcError.cs, FramingError.cs), as the other SDKs name theirs.
dotnet_diagnostic.CA1710.severity = none
dotnet_diagnostic.CA1032.severity = none

# The SDK is a library for plugin processes: no localisation, no user interface, no logging framework.
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1308.severity = none
dotnet_diagnostic.CA1848.severity = none

# Library code awaits on the thread-pool anyway; there is no synchronization context to avoid.
dotnet_diagnostic.CA2007.severity = none

# Messages of the protocol are plain data with generated, mutable-looking collection members.
dotnet_diagnostic.CA2227.severity = none
dotnet_diagnostic.CA1002.severity = none
dotnet_diagnostic.CA1056.severity = none
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1720.severity = none
dotnet_diagnostic.CA1819.severity = none
dotnet_diagnostic.CA1812.severity = none

# JsonAny converts implicitly from the four scalar types; the conversions are the alternate.
dotnet_diagnostic.CA2225.severity = none


# The SDK runs plugin code and answers any failure of it as an error response, so a general catch is the design.
dotnet_diagnostic.CA1031.severity = none

# MessageParseError never leaves the assembly: the serve loop and the host turn it into an answer.
dotnet_diagnostic.CA1064.severity = none

# The few operating system calls (kernel32, libc) that take the standard handles are declared in one file and load
# from the system.
[Stdio/StdioNativeClient.cs]
dotnet_diagnostic.CA5392.severity = none
dotnet_diagnostic.SYSLIB1054.severity = none
