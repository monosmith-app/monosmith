{
  "name": "@monosmith/eslint-config",
  "version": "0.0.0",
  "type": "module",
  "description": "The shared ESLint flat config every MonoSmith monorepo uses: one root config that lints and formats TS/JS, React, Svelte, Astro, JSON, YAML, TOML, Markdown, CSS and HTML, with vertical-slice rules.",
  "publishConfig": {
    "access": "public"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./configs/*": "./configs/*.config.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "configs"
  ],
  "scripts": {
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "flat-config",
    "monosmith",
    "vertical-slices"
  ],
  "author": "Eduardo Russo",
  "license": "MIT",
  "homepage": "https://github.com/monosmith-app/monosmith/tree/main/packages/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monosmith-app/monosmith.git",
    "directory": "packages/eslint-config"
  },
  "peerDependencies": {
    "eslint": "^10.8.1"
  },
  "peerDependenciesMeta": {
    "@nx/eslint-plugin": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.20.5",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.0",
    "@eslint/markdown": "^8.0.2",
    "@html-eslint/eslint-plugin": "^0.65.0",
    "@html-eslint/parser": "^0.65.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsonc": "^3.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-mdx": "^3.8.1",
    "eslint-plugin-n": "^18.2.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-svelte": "^3.23.1",
    "eslint-plugin-toml": "^1.5.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-yml": "^3.5.0",
    "globals": "^17.9.0",
    "jsonc-eslint-parser": "^3.3.0",
    "toml-eslint-parser": "^1.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "devDependencies": {
    "@types/jest": "~30.0.0",
    "jest": "~30.5.2",
    "ts-jest": "^29.4.14"
  }
}
