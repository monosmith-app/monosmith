{
  "name": "@monosmith/jest-preset",
  "version": "0.0.0",
  "description": "The Jest preset every MonoSmith monorepo uses: the values @nx/jest/preset provided, a TypeScript-aware resolver (tsconfig paths, types-only modules) wired in, and an asset transform for React projects.",
  "publishConfig": {
    "access": "public"
  },
  "main": "./jest-preset.cjs",
  "exports": {
    ".": "./jest-preset.cjs",
    "./jest-preset": "./jest-preset.cjs",
    "./jest-preset.cjs": "./jest-preset.cjs",
    "./resolver": "./resolver.cjs",
    "./resolver.cjs": "./resolver.cjs",
    "./asset-transform": "./asset-transform.cjs",
    "./asset-transform.cjs": "./asset-transform.cjs",
    "./style-stub": "./style-stub.cjs",
    "./file-stub": "./file-stub.cjs",
    "./react": "./react/jest-preset.cjs",
    "./react/jest-preset": "./react/jest-preset.cjs",
    "./react/jest-preset.cjs": "./react/jest-preset.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "jest-preset.cjs",
    "resolver.cjs",
    "asset-transform.cjs",
    "style-stub.cjs",
    "file-stub.cjs",
    "react",
    "src",
    "!src/**/*.spec.*"
  ],
  "scripts": {
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "jest",
    "jest-preset",
    "monosmith",
    "ts-jest",
    "typescript"
  ],
  "author": "Eduardo Russo",
  "license": "MIT",
  "homepage": "https://github.com/monosmith-app/monosmith/tree/main/packages/jest-preset#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monosmith-app/monosmith.git",
    "directory": "packages/jest-preset"
  },
  "peerDependencies": {
    "babel-jest": ">=29",
    "jest": ">=29",
    "jest-environment-jsdom": ">=29",
    "ts-jest": ">=29",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "babel-jest": {
      "optional": true
    },
    "jest-environment-jsdom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "~30.0.0",
    "jest": "~30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-jest": "^29.4.14"
  }
}
